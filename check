usage_en() {
    cat <<EOF
${B}${C}check${N} — network and system status tool

${B}USAGE${N}
  check [${G}--lang en|tr${N}] ${G}<command>${N}

${B}COMMANDS${N}
  ${G}wifi${N}              Details of the connected wireless network:
                    • Network name (SSID) and BSSID (which router band)
                    • Band (2.4 / 5 GHz), channel, frequency, link rate
                    • Signal percentage (colored bar) and dBm value
                    • Local IP, gateway (router), DNS, MAC address
                    • Nearby networks; those on your channel are marked (interference)

  ${G}cable${N}, ${G}kablo${N}      Ethernet connection:
                    • Cable plugged in or not, link speed (Mb/s), duplex
                    • Local IP, gateway, DNS, MAC

  ${G}internet${N}, ${G}net${N}     Internet connection quality:
                    • Public IP and Cloudflare server location
                    • Ping to router, Cloudflare (1.1.1.1), Google (8.8.8.8)
                      → average latency, jitter, packet loss
                    • DNS lookup time

  ${G}speed${N}, ${G}hiz${N}        internet + speed test (Cloudflare, ~20 s):
                    • Download (4 parallel connections) and upload speed, Mbps

  ${G}sys${N}, ${G}sistem${N}       System resources and hardware monitor:
                    • CPU model, real-time utilization % and temperature
                    • RAM and Swap memory usage (GB and percentage)
                    • GPU model, utilization %, VRAM, and temperature (NVIDIA/AMD/Intel)

  ${G}all${N} (or empty)    wifi + cable + internet (no speed test)

  ${G}-h${N}, ${G}--help${N}        Show this help

${B}LANGUAGE${N}
  The default comes from your system locale (tr → Turkish, others → English).
  ${G}--lang en${N} / ${G}--lang tr${N}  pick the language for this run
  ${G}CHECK_LANG=en${N}          export it in ~/.bashrc or ~/.zshrc to make it permanent

${B}COLORS${N}
  ${G}green${N} good   ${Y}yellow${N} fair   ${R}red${N} bad

${B}READING THE RESULTS${N}
  • Router ping high/unstable     → WiFi problem (signal, channel, interference)
  • Router fine, external bad     → internet provider problem
  • Signal: -50 dBm excellent · -67 good · -75 or below weak
  • Typical: router ping <5 ms, external ping ~50 ms
  • System load: <70% green, 70%-85% yellow, >85% red (<60°C green, 60-80°C yellow, >80°C red)

${B}EXAMPLES${N}
  check wifi
  check speed
  check internet speed
  check sys
  check --lang tr sys
