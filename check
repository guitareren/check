case "$1" in
    -h|--help|help) usage_$LNG; exit 0 ;;
    wifi)          cmd_wifi  || exit 1 ;;
    cable|kablo)   cmd_cable || exit 1 ;;
    internet|net)  cmd_internet "$2" ;;
    speed|hiz)     cmd_internet speed ;;
    sys|sistem|system) cmd_sys ;;
    all|"")
        if command -v nmcli &>/dev/null; then
            cmd_wifi quiet
        else
            echo "  ${ED}$(t "(NetworkManager bulunamadı; WiFi atlandı)" "(NetworkManager not found; skipping WiFi)")${EN}" >&2
        fi
        cmd_cable quiet
        cmd_internet
        ;;
    *) { echo "${ER}$(t "Bilinmeyen komut:" "Unknown command:")${EN} $1"; echo "$(t "Yardım için" "For help"): check --help"
       [[ $1 == -l* || $1 == --l* ]] && echo "$(t "Dil seçimi" "Language"): check --lang en wifi"; } >&2
       exit 1 ;;
esac
echo
