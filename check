case "$1" in
    -h|--help|help) usage_$LNG; exit 0 ;;
    wifi)          cmd_wifi  || exit 1 ;;
    cable|kablo)   cmd_cable || exit 1 ;;
    internet|net)  cmd_internet "$2" ;;
    speed|hiz)     cmd_internet speed ;;
    sys|sistem|system) cmd_sys ;;
    all|"")        cmd_wifi; cmd_cable; cmd_internet ;;
    *) { echo "${R}$(t "Bilinmeyen komut:" "Unknown command:")${N} $1"; echo "$(t "Yardım için" "For help"): check --help"
       [[ $1 == -l* || $1 == --l* ]] && echo "$(t "Dil seçimi" "Language"): check --lang en wifi"; } >&2
       exit 1 ;;
esac
echo
