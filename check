#!/usr/bin/env bash
# check — small terminal tool for network and system status
# Usage: check [--lang en|tr] wifi | cable | internet [speed] | speed | sys

# Language: --lang > CHECK_LANG > system locale (tr → Turkish, anything else → English)
LNG=${CHECK_LANG:-${LC_ALL:-${LC_MESSAGES:-$LANG}}}
args=()
while (( $# )); do
    case $1 in
        -l|-lang|--lang)  # value must be a 2-letter code, otherwise it's the command (e.g. "--lang wifi")
            if [[ $2 =~ ^[A-Za-z]{2}$ ]]; then LNG=$2; shift 2; else shift; fi ;;
        -lang=*|--lang=*) LNG=${1#*=}; shift ;;
        *)         args+=("$1"); shift ;;
    esac
done
set -- "${args[@]}"
LNG=${LNG:0:2}; LNG=${LNG,,}; [[ $LNG == tr ]] || LNG=en
t() { if [[ $LNG == tr ]]; then printf %s "$1"; else printf %s "$2"; fi; }  # t <turkish> <english>

ORIG_CTYPE=${LC_ALL:-${LC_CTYPE:-$LANG}}
lc() { LC_ALL='' LANGUAGE='' LC_CTYPE="$ORIG_CTYPE" LC_MESSAGES=C LC_NUMERIC=C "$@"; }
B='' D='' R='' G='' Y='' C='' N=''  # don't inherit these from the environment
if [[ -t 1 && -z $NO_COLOR ]]; then  # no colors when piped or NO_COLOR is set
    B=$'\e[1m'; D=$'\e[2m'; R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; N=$'\e[0m'
fi
ER='' EN='' ED=''
if [[ -t 2 && -z $NO_COLOR ]]; then ER=$'\e[31m'; EN=$'\e[0m'; ED=$'\e[2m'; fi

UNI=0
case "$ORIG_CTYPE" in
    *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) UNI=1 ;;
esac
[[ -n $CHECK_ASCII ]] && UNI=0          # zorla ASCII
if (( UNI )); then FULL='█' EMPTY='░' LINE='━━' ARR='←' DASH='—' DOT='·' DEG='°C'
else               FULL='#' EMPTY='-' LINE='==' ARR='<-' DASH='-'  DOT='|' DEG='C'; fi

title() { printf "\n${B}${C}${LINE} %s ${LINE}${N}\n" "$1"; }
row()   { local pad=$(( 16 - ${#1} )); (( pad < 1 )) && pad=1; printf "  ${D}%s%*s${N}%s\n" "$1" $pad "" "$2"; }
bar() { # bar <percent>
    local p=${1%.*}
    [[ $p =~ ^-?[0-9]+$ ]] || { printf "%s" "${D}${DASH}${N}"; return; }
    (( p < 0 )) && p=0; (( p > 100 )) && p=100
    local n=$(( p / 5 )) col=$G
    (( p < 60 )) && col=$Y; (( p < 35 )) && col=$R
    local f="" e=""
    (( n > 0 )) && f=$(printf -- "$FULL%.0s" $(seq 1 $n))
    (( 20 - n > 0 )) && e=$(printf -- "$EMPTY%.0s" $(seq 1 $((20 - n))))
    printf "${col}%s${D}%s${N} %s%%" "$f" "$e" "$p"
}
grade() { # grade <value> <good> <fair>  (lower = better)
    awk -v v="$1" -v a="$2" -v b="$3" -v g="$G" -v y="$Y" -v r="$R" -v n="$N" \
        'BEGIN{c=(v<=a)?g:(v<=b)?y:r; printf "%s%s%s", c, v, n}'
}
bar_usage() { # bar_usage <percent>  (higher = warning/alert)
    local p=${1%.*}
    [[ $p =~ ^-?[0-9]+$ ]] || { printf "%s" "${D}${DASH}${N}"; return; }
    (( p < 0 )) && p=0; (( p > 100 )) && p=100
    local n=$(( p / 5 )) col=$G
    (( p >= 70 )) && col=$Y; (( p > 85 )) && col=$R
    local f="" e=""
    (( n > 0 )) && f=$(printf -- "$FULL%.0s" $(seq 1 $n))
    (( 20 - n > 0 )) && e=$(printf -- "$EMPTY%.0s" $(seq 1 $((20 - n))))
    printf "${col}%s${D}%s${N} %s%%" "$f" "$e" "$p"
}
grade_temp() { # grade_temp <celsius>
    local t=$1
    [[ $t =~ ^-?[0-9]+$ ]] || return
    local col=$G
    (( t >= 60 )) && col=$Y; (( t > 80 )) && col=$R
    printf "${col}%s%s${N}" "$t" "$DEG"
}
iface_of() { lc nmcli -t -f DEVICE,TYPE dev | awk -F: -v t="$1" '$2==t{print $1; exit}'; }
gw_of() { # gw_of [dev]  → ilk "via" adresi; yoksa boş
    if [[ -n $1 ]]; then ip route show default dev "$1" 2>/dev/null
    else                 ip route show default 2>/dev/null; fi \
        | awk '{for(i=1;i<NF;i++) if($i=="via"){print $(i+1); exit}}'
}
eth_iface() {
    local d n def cands=()
    def=$(ip route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
    for d in /sys/class/net/*; do
        n=${d##*/}
        [[ -e $d/device ]] || continue                        # sanal: lo, bridge, docker0, veth, bond, tun
        [[ -d $d/wireless || -e $d/phy80211 ]] && continue    # WiFi
        [[ $(cat "$d/type" 2>/dev/null) == 1 ]] || continue   # ARPHRD_ETHER
        cands+=("$n")
    done
    (( ${#cands[@]} )) || return 1
    for n in "${cands[@]}"; do [[ $n == "$def" ]] && { echo "$n"; return; }; done          # 1. default route
    for n in "${cands[@]}"; do [[ $(cat /sys/class/net/$n/carrier 2>/dev/null) == 1 ]] && { echo "$n"; return; }; done  # 2. kablo takılı
    echo "${cands[0]}"                                                                       # 3. ilk aday
}
dns_of() { # dns_of <dev>
    local out
    if command -v nmcli &>/dev/null; then
        out=$(lc nmcli -t -f IP4.DNS dev show "$1" 2>/dev/null | cut -d: -f2 | paste -sd' ')
    fi
    if [[ -z $out ]] && command -v resolvectl &>/dev/null; then
        out=$(lc resolvectl dns "$1" 2>/dev/null | sed 's/^Link [0-9]* ([^)]*): *//')
    fi
    if [[ -z $out && -r /etc/resolv.conf ]]; then
        out=$(awk '$1=="nameserver"{print $2}' /etc/resolv.conf | paste -sd' ')
        [[ -n $out ]] && out="$out  ${D}($(t "sistem geneli" "system-wide"))${N}"
    fi
    printf %s "$out"
}
fmt_speed() { # fmt_speed <raw>
    if [[ $1 =~ ^[0-9]+$ ]] && (( $1 > 0 )); then echo "$1 Mb/s"; else t "bilinmiyor" "unknown"; fi
}
ipinfo() {
    local dev=$1
    row "$(t "Yerel IP" "Local IP")" "$(ip -4 -br addr show "$dev" | awk '{print $3}')"
    local gw; gw=$(gw_of "$dev")
    row "Gateway"   "${gw:-${D}${DASH}${N}}"
    row "DNS"       "$(dns_of "$dev")"
    row "MAC"       "$(cat /sys/class/net/"$dev"/address)"
}

band_of() { # band_of <MHz>
    local m=$1
    if   (( m >= 5925 )); then echo "6 GHz"
    elif (( m >  4900 )); then echo "5 GHz"
    else                       echo "2.4 GHz"; fi
}

chan_mark() { # chan_mark <own_chan> <own_mhz> <chan> <mhz>  → same | adjacent | (boş)
    local oc=$1 om=$2 c=$3 m=$4
    [[ $(band_of "$om") == "$(band_of "$m")" ]] || return 0
    if (( c == oc )); then echo same
    elif [[ $(band_of "$om") == "2.4 GHz" ]] && (( c - oc <= 4 && oc - c <= 4 )); then echo adjacent
    fi
}

cmd_wifi() {
    if ! command -v nmcli &>/dev/null; then
        echo "${ER}$(t "Bu komut NetworkManager (nmcli) gerektirir." "This command requires NetworkManager (nmcli).")${EN}" >&2
        return 1
    fi
    local dev; dev=$(iface_of wifi)
    [[ -z $dev ]] && { [[ $1 == quiet ]] || echo "${ER}$(t "WiFi arayüzü yok" "No WiFi interface")${EN}" >&2; return 1; }
    title "WiFi $DASH $dev"
    local scan
    scan=$(lc nmcli -t -e yes -f ACTIVE,SSID,BSSID,CHAN,FREQ,RATE,SIGNAL,SECURITY \
           dev wifi list ifname "$dev" --rescan auto | sed 's/\\:/-/g')
    local line
    line=$(grep '^yes:' <<<"$scan")
    if [[ -z $line ]]; then echo "  ${R}$(t "Bağlı değil" "Not connected")${N}"; return; fi
    IFS=: read -r _ ssid bssid chan freq rate sig sec <<<"$line"
    local mhz=${freq% *} band; band=$(band_of "$mhz")
    local iw link=""
    iw=$(command -v iw || { [[ -x /usr/sbin/iw ]] && echo /usr/sbin/iw; })
    [[ -n $iw ]] && link=$(lc "$iw" dev "$dev" link 2>/dev/null)
    local dbm; dbm=$(awk -v d="$dev:" '$1==d{gsub(/\./,"",$4); print $4}' /proc/net/wireless 2>/dev/null)
    [[ -z $dbm && -n $link ]] && dbm=$(sed -n 's/.*signal:[ \t]*\(-*[0-9]*\).*/\1/p' <<<"$link")
    row "$(t "Ağ (SSID)" "Network (SSID)")" "${B}$ssid${N}"
    row "BSSID"     "${bssid//-/:}"
    row "$(t "Bant" "Band")" "$band  ($(t kanal channel) $chan, $freq)"
    local speed_str=""
    if [[ -n $link ]]; then
        local rx; rx=$(sed -n 's/.*rx bitrate:[ \t]*\([0-9.]*\).*/\1/p' <<<"$link")
        local tx; tx=$(sed -n 's/.*tx bitrate:[ \t]*\([0-9.]*\).*/\1/p' <<<"$link")
        if [[ -n $rx && -n $tx ]]; then
            speed_str="rx $rx / tx $tx Mbit/s"
        elif [[ -n $rx ]]; then
            speed_str="rx $rx Mbit/s"
        elif [[ -n $tx ]]; then
            speed_str="tx $tx Mbit/s"
        fi
    fi
    if [[ -n $speed_str ]]; then
        local ap_max=""; [[ -n $rate ]] && ap_max="  ($(t "AP maks." "AP max") $rate)"
        row "$(t "Hız" "Rate")" "$speed_str$ap_max"
    else
        row "$(t "AP maks. hız" "AP max rate")" "$rate"
    fi
    row "$(t "Sinyal" "Signal")" "$(bar "$sig")"
    [[ -n $dbm ]] && row "$(t "Seviye" "Level")" "$dbm dBm  ${D}($(t "-50 çok iyi $DOT -67 iyi $DOT -75 zayıf" "-50 excellent $DOT -67 good $DOT -75 weak"))${N}"
    row "$(t "Güvenlik" "Security")" "$sec"
    ipinfo "$dev"
    title "$(t "Çevredeki ağlar (aynı/komşu kanal = parazit)" "Nearby networks (same/adjacent channel = interference)")"
    local same here own adj
    same=$(t "$ARR aynı kanal" "$ARR same channel")
    here=$(t "$ARR bağlı" "$ARR connected")
    own=$(t "$ARR aynı modem" "$ARR same router")
    adj=$(t "$ARR komşu kanal" "$ARR adjacent channel")
    sort -t: -k7 -nr <<<"$scan" | head -8 \
        | while IFS=: read -r _ s b c f _ g _; do
            mark=""
            if [[ $b == "$bssid" ]]; then mark="${G}$here${N}"
            elif [[ ${b:0:14} == "${bssid:0:14}" ]]; then mark="${D}$own${N}"  # same router, other band/SSID
            else
                local cm
                cm=$(chan_mark "$chan" "$mhz" "$c" "${f% *}")
                if [[ $cm == same ]]; then mark="${Y}$same${N}"
                elif [[ $cm == adjacent ]]; then mark="${Y}$adj${N}"; fi
            fi
            local sn; sn=${s:0:22}; sn=${sn:-$(t "<gizli>" "<hidden>")}
            local pad=$(( 22 - ${#sn} )); (( pad < 0 )) && pad=0
            printf "  %s%*s ${D}%s${N} %-4s %3s%% %s\n" "$sn" $pad "" "$(t kanal ch)" "$c" "$g" "$mark"
          done
}

cmd_cable() {
    if ! command -v ip &>/dev/null; then
        echo "${ER}$(t "Bu komut iproute2 (ip) gerektirir." "This command requires iproute2 (ip).")${EN}" >&2
        return 1
    fi
    local dev; dev=$(eth_iface)
    [[ -z $dev ]] && { [[ $1 == quiet ]] || echo "${ER}$(t "Ethernet arayüzü yok" "No Ethernet interface")${EN}" >&2; return 1; }
    title "$(t Kablo Cable) $DASH $dev"
    if [[ $(cat /sys/class/net/"$dev"/carrier 2>/dev/null) != 1 ]]; then
        row "$(t Durum Status)" "${R}$(t "Kablo takılı değil" "Cable not plugged in")${N}"
        row "MAC" "$(cat /sys/class/net/"$dev"/address)"; return
    fi
    row "$(t Durum Status)" "${G}$(t Bağlı Connected)${N}"
    local sp dup
    sp=$(cat /sys/class/net/"$dev"/speed 2>/dev/null)
    dup=$(cat /sys/class/net/"$dev"/duplex 2>/dev/null)
    [[ -z $dup || $dup == unknown ]] && dup=$(t "bilinmiyor" "unknown")
    row "$(t Hız Speed)"    "$(fmt_speed "$sp")"
    row "Duplex" "$dup"
    ipinfo "$dev"
}

cmd_internet() {
    title "$(t İnternet Internet)"
    local gw; gw=$(gw_of)
    local trace; trace=$(curl -s -m 5 https://1.1.1.1/cdn-cgi/trace)
    row "$(t "Dış IP" "Public IP")" "$(grep ^ip= <<<"$trace" | cut -d= -f2)"
    row "$(t Konum Location)" "$(grep ^loc= <<<"$trace" | cut -d= -f2)  ${D}(Cloudflare $(grep ^colo= <<<"$trace" | cut -d= -f2))${N}"
    for tg in "gw:$gw" "Cloudflare:1.1.1.1" "Google:8.8.8.8"; do
        local name=${tg%%:*} host=${tg#*:} out
        local label=$name; [[ $name == gw ]] && label=$(t Modem Router)
        if [[ $name == gw && -z $host ]]; then
            if [[ -z $(ip route show default 2>/dev/null) ]]; then
                row "Ping $label" "${R}$(t "varsayılan rota yok (ağ bağlantısı yok)" "no default route (not connected)")${N}"
            else
                row "Ping $label" "${D}$(t "gateway yok (VPN/doğrudan bağlantı)" "no gateway (VPN/point-to-point)")${N}"
            fi
            continue
        fi
        out=$(lc ping -c 10 -i 0.2 -W 1 "$host" 2>/dev/null)
        local loss; loss=$(sed -n 's/.* \([0-9.]*\)% packet loss.*/\1/p' <<<"$out")
        IFS=/ read -r _ avg _ jit <<<"$(sed -n 's/.*= \([0-9./]*\) ms.*/\1/p' <<<"$out")"
        if [[ -z $avg ]]; then row "Ping $label" "${R}$(t "yanıt yok" "no reply")${N}"; continue; fi
        local good=5 ok=20; [[ $name != gw ]] && good=30 ok=80
        local jit_str="${D}${DASH}${N}"
        [[ -n $jit ]] && jit_str="$(grade "$jit" 5 20) ms"
        row "Ping $label" "$(grade "$avg" $good $ok) ms  ${D}jitter${N} $jit_str  ${D}$(t kayıp loss)${N} $(grade "$loss" 0 2)%"
    done
    local dns rc
    dns=$(curl -s -o /dev/null -m 5 --noproxy '*' -w '%{time_namelookup}' https://example.org); rc=$?
    if (( rc == 6 )) || awk -v t="$dns" 'BEGIN{exit !(t <= 0)}'; then
        row "$(t "DNS çözme" "DNS lookup")" "${R}$(t "ölçülemedi (isim çözülemedi)" "failed (could not resolve)")${N}"
    else
        row "$(t "DNS çözme" "DNS lookup")" "$(grade "$(awk -v t="$dns" 'BEGIN{printf "%.0f", t*1000}')" 30 100) ms"
    fi
    if [[ $1 == speed ]]; then speed; fi
}

progress() { [[ -t 1 ]] && printf "  ${D}%s${N}\r" "$1"; }  # temporary line, terminal only

speed() {
    title "$(t "Hız testi" "Speed test") (Cloudflare)"
    progress "$(t "İndirme ölçülüyor..." "Measuring download...")"
    local down; down=$(for _ in 1 2 3 4; do
        curl -s -o /dev/null -m 20 -w '%{http_code} %{speed_download}\n' "https://speed.cloudflare.com/__down?bytes=25000000" &
    done; wait)
    row "$(t İndirme Download)" "$(mbps "$down")       "   # sum of 4 parallel connections
    progress "$(t "Yükleme ölçülüyor..." "Measuring upload...")"
    local up; up=$(head -c 25000000 /dev/zero | curl -s -o /dev/null -m 20 -w '%{http_code} %{speed_upload}\n' --data-binary @- https://speed.cloudflare.com/__up)
    row "$(t Yükleme Upload)" "$(mbps "$up")       "
}

mbps() { # mbps <"http_code bytes/s" lines> → sum of successful ones, or an error
    local res; res=$(awk '$1==200{t+=$2; ok++} $1!=200{c=$1} END{if(ok) printf "%.1f", t*8/1e6; else print "E" c}' <<<"$1")
    case $res in
        E429) printf "${R}%s${N}" "$(t "ölçülemedi — Cloudflare sınırı (429), birkaç dk sonra dene" "failed — Cloudflare rate limit (429), try again in a few minutes")" ;;
        E000) printf "${R}%s${N}" "$(t "ölçülemedi — bağlantı yok" "failed — no connection")" ;;
        E*)   printf "${R}%s${N}" "$(t "ölçülemedi — HTTP" "failed — HTTP") ${res#E}" ;;
        *)    printf "${B}%s Mbps${N}" "$res" ;;
    esac
}

sys_cpu_model() {
    local cpu_model=""
    if [[ -f /proc/cpuinfo ]]; then
        cpu_model=$(grep -m1 '^model name' /proc/cpuinfo | cut -d: -f2- | sed -e 's/^[ \t]*//' -e 's/[ \t]*$//')
        if [[ -z $cpu_model ]]; then
            cpu_model=$(grep -m1 -E '^(Hardware|Processor|cpu model)' /proc/cpuinfo | cut -d: -f2- | sed -e 's/^[ \t]*//' -e 's/[ \t]*$//')
        fi
    fi
    if [[ -z $cpu_model ]] && command -v lscpu &>/dev/null; then
        cpu_model=$(lc lscpu 2>/dev/null | grep -m1 '^Model name:' | cut -d: -f2- | sed -e 's/^[ \t]*//' -e 's/[ \t]*$//')
    fi
    [[ -z $cpu_model ]] && cpu_model=$(uname -m)
    echo "$cpu_model" | tr -s ' '
}

sys_cpu_temp() {
    local cpu_temp="" raw_temp=""
    # Tier 1: Known hwmon CPU driver names
    for h in /sys/class/hwmon/hwmon*; do
        [[ -d "$h" ]] || continue
        local hname; hname=$(cat "$h/name" 2>/dev/null)
        case "$hname" in
            k10temp|zenpower|coretemp|cpu_thermal|soc_thermal)
                for lbl in "$h"/temp*_label; do
                    [[ -f "$lbl" ]] || continue
                    local lval; lval=$(cat "$lbl" 2>/dev/null)
                    if [[ $lval =~ (Tctl|Package|Tdie|CPU) ]]; then
                        local inp="${lbl%_label}_input"
                        if [[ -f "$inp" ]]; then
                            raw_temp=$(cat "$inp" 2>/dev/null)
                            break 2
                        fi
                    fi
                done
                if [[ -z $raw_temp && -f "$h/temp1_input" ]]; then
                    raw_temp=$(cat "$h/temp1_input" 2>/dev/null)
                    break
                fi
                ;;
        esac
    done

    # Tier 2: Generic label scan across all hwmon devices
    if [[ -z $raw_temp ]]; then
        for lbl in /sys/class/hwmon/hwmon*/temp*_label; do
            [[ -f "$lbl" ]] || continue
            local lval; lval=$(cat "$lbl" 2>/dev/null)
            if [[ $lval =~ (Tctl|Package|Tdie|CPU) ]]; then
                local inp="${lbl%_label}_input"
                if [[ -f "$inp" ]]; then
                    raw_temp=$(cat "$inp" 2>/dev/null)
                    [[ -n $raw_temp ]] && break
                fi
            fi
        done
    fi

    # Tier 3: ACPI /sys/class/thermal/thermal_zone*
    if [[ -z $raw_temp ]]; then
        for tz in /sys/class/thermal/thermal_zone*; do
            [[ -d "$tz" ]] || continue
            local type; type=$(cat "$tz/type" 2>/dev/null)
            case "$type" in
                x86_pkg_temp|cpu-thermal|cpu_thermal|k10temp|coretemp|acpitz)
                    if [[ -f "$tz/temp" ]]; then
                        raw_temp=$(cat "$tz/temp" 2>/dev/null)
                        [[ -n $raw_temp ]] && break
                    fi
                    ;;
            esac
        done
    fi

    # Normalize raw millidegrees or degrees
    if [[ -n $raw_temp && $raw_temp =~ ^[0-9]+$ ]]; then
        if (( raw_temp > 1000 )); then
            cpu_temp=$(( (raw_temp + 500) / 1000 ))
        else
            cpu_temp=$raw_temp
        fi
    fi

    # Tier 4: sensors CLI fallback
    if [[ -z $cpu_temp ]] && command -v sensors &>/dev/null; then
        local s_line
        s_line=$(lc sensors 2>/dev/null | grep -m1 -E '(Tctl|Package id|CPU Temperature|CPU):')
        if [[ -n $s_line ]]; then
            local s_val
            s_val=$(awk '{for(i=1;i<=NF;i++) if($i~/°C$/){gsub(/[+°C]/,"",$i); print $i; exit}}' <<<"$s_line")
            [[ -n $s_val ]] && cpu_temp=$(awk -v v="$s_val" 'BEGIN{printf "%.0f", v}')
        fi
    fi

    echo "$cpu_temp"
}

sys_mem() {
    local mem_total=0 mem_free=0 mem_avail=0 buffers=0 cached=0 sreclaimable=0
    local swap_total=0 swap_free=0
    if [[ -f /proc/meminfo ]]; then
        while IFS=': ' read -r key val _; do
            case "$key" in
                MemTotal)     mem_total=$val ;;
                MemFree)      mem_free=$val ;;
                MemAvailable) mem_avail=$val ;;
                Buffers)      buffers=$val ;;
                Cached)       cached=$val ;;
                SReclaimable) sreclaimable=$val ;;
                SwapTotal)    swap_total=$val ;;
                SwapFree)     swap_free=$val ;;
            esac
        done < /proc/meminfo
    fi

    local mem_used=0 ram_pct=0 ram_str=""
    if (( mem_total > 0 )); then
        if (( mem_avail > 0 )); then
            mem_used=$(( mem_total - mem_avail ))
        else
            mem_used=$(( mem_total - (mem_free + buffers + cached + sreclaimable) ))
        fi
        (( mem_used < 0 )) && mem_used=0
        ram_pct=$(( mem_used * 100 / mem_total ))
        ram_str=$(awk -v u="$mem_used" -v t="$mem_total" 'BEGIN{printf "%.1f / %.1f GiB", u/1048576, t/1048576}')
        row "RAM" "$(bar_usage "$ram_pct")  $ram_str"
    fi

    local swap_used=0 swap_pct=0 swap_str=""
    if (( swap_total > 0 )); then
        swap_used=$(( swap_total - swap_free ))
        (( swap_used < 0 )) && swap_used=0
        swap_pct=$(( swap_used * 100 / swap_total ))
        swap_str=$(awk -v u="$swap_used" -v t="$swap_total" 'BEGIN{printf "%.1f / %.1f GiB", u/1048576, t/1048576}')
        row "Swap" "$(bar_usage "$swap_pct")  $swap_str"
    fi
}

print_gpu() { # print_gpu <label> <model> <usage_pct> <vram_pct> <vram_str> <temp>
    local lbl=$1 model=$2 pct=$3 v_pct=$4 v_str=$5 temp=$6
    [[ -z $model ]] && return
    row "$lbl" "$model"
    [[ -n $pct ]] && row "$(t "$lbl Kullanım" "$lbl Usage")" "$(bar_usage "$pct")"
    if [[ -n $v_str ]]; then
        if [[ -n $v_pct ]]; then
            row "$(t "$lbl Bellek" "$lbl VRAM")" "$(bar_usage "$v_pct")  $v_str"
        else
            row "$(t "$lbl Bellek" "$lbl VRAM")" "$v_str"
        fi
    fi
    [[ -n $temp ]] && row "$(t "$lbl Sıcaklık" "$lbl Temp")" "$(grade_temp "$temp")"
}

has_nvidia_gpu() { # PCI'da NVIDIA (vendor 0x10de) ekran denetleyicisi (class 0x03xxxx) var mı?
    local d
    for d in /sys/bus/pci/devices/*; do
        [[ $(cat "$d/vendor" 2>/dev/null) == 0x10de && $(cat "$d/class" 2>/dev/null) == 0x03* ]] && return 0
    done
    return 1
}

sys_gpu() {
    local gpus_model=() gpus_pct=() gpus_vram_pct=() gpus_vram_str=() gpus_temp=()

    # 4a. NVIDIA
    local nv_state=""            # "" = sorun yok, "fail" = nvidia-smi başarısız, "missing" = nvidia-smi yok
    if command -v nvidia-smi &>/dev/null; then
        local nv_out nv_line
        if nv_out=$(lc nvidia-smi --query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu \
                    --format=csv,noheader,nounits 2>/dev/null) && [[ -n $nv_out ]]; then
            while IFS= read -r nv_line; do
                [[ $nv_line =~ ^[^,]+(,[^,]*){4}$ ]] || continue     # tam 5 alan yoksa (hata mesajı vb.) atla
                IFS=',' read -r name pct vu vt temp <<<"$nv_line"
                [[ -z $name ]] && continue
                name=$(echo "$name" | sed -e 's/^[ \t]*//' -e 's/[ \t]*$//')
                pct=$(echo "$pct" | tr -d '[:space:]')
                vu=$(echo "$vu" | tr -d '[:space:]')
                vt=$(echo "$vt" | tr -d '[:space:]')
                temp=$(echo "$temp" | tr -d '[:space:]')
                [[ $pct  =~ ^[0-9]+$ ]] || pct=""
                [[ $temp =~ ^[0-9]+$ ]] || temp=""
                local v_pct="" v_str=""
                if [[ $vt =~ ^[0-9]+$ && $vt -gt 0 && $vu =~ ^[0-9]+$ ]]; then
                    v_pct=$(( vu * 100 / vt ))
                    v_str=$(awk -v u="$vu" -v t="$vt" 'BEGIN{if(t>=1024) printf "%.1f / %.1f GiB", u/1024, t/1024; else printf "%d / %d MiB", u, t}')
                fi
                gpus_model+=("$name")
                gpus_pct+=("$pct")
                gpus_vram_pct+=("$v_pct")
                gpus_vram_str+=("$v_str")
                gpus_temp+=("$temp")
            done <<<"$nv_out"
        else
            nv_state=fail
        fi
    else
        nv_state=missing
    fi

    # 4b. AMD
    for card in /sys/class/drm/card[0-9]; do
        [[ -d "$card/device" ]] || continue
        local drv; drv=$(grep -s '^DRIVER=' "$card/device/uevent" 2>/dev/null | cut -d= -f2)
        if [[ $drv == amdgpu ]]; then
            local gpu_model="" gpu_pct="" gpu_temp="" vram_pct="" vram_str=""
            if [[ -f "$card/device/product_name" ]]; then
                gpu_model=$(cat "$card/device/product_name" 2>/dev/null)
            fi
            if [[ -z $gpu_model ]] && command -v lspci &>/dev/null; then
                local slot; slot=$(basename "$(readlink -f "$card/device")")
                gpu_model=$(lc lspci -s "$slot" 2>/dev/null | sed -e 's/.*: //' -e 's/ (rev .*)//')
            fi
            [[ -z $gpu_model ]] && gpu_model="AMD Radeon GPU"

            if [[ -f "$card/device/gpu_busy_percent" ]]; then
                gpu_pct=$(cat "$card/device/gpu_busy_percent" 2>/dev/null | tr -d '[:space:]')
            fi
            [[ $gpu_pct =~ ^[0-9]+$ ]] || gpu_pct=""

            if [[ -f "$card/device/mem_info_vram_used" && -f "$card/device/mem_info_vram_total" ]]; then
                local vu vt
                vu=$(cat "$card/device/mem_info_vram_used" 2>/dev/null | tr -d '[:space:]')
                vt=$(cat "$card/device/mem_info_vram_total" 2>/dev/null | tr -d '[:space:]')
                if [[ $vt =~ ^[0-9]+$ && $vt -gt 0 && $vu =~ ^[0-9]+$ ]]; then
                    vram_pct=$(( (vu * 100) / vt ))
                    vram_str=$(awk -v u="$vu" -v t="$vt" 'BEGIN{printf "%.1f / %.1f GiB", u/1073741824, t/1073741824}')
                fi
            fi

            for h in "$card/device"/hwmon/hwmon*; do
                [[ -d "$h" ]] || continue
                local hname; hname=$(cat "$h/name" 2>/dev/null)
                if [[ $hname == amdgpu && -f "$h/temp1_input" ]]; then
                    local raw_t; raw_t=$(cat "$h/temp1_input" 2>/dev/null)
                    if [[ $raw_t =~ ^[0-9]+$ ]]; then
                        gpu_temp=$(( (raw_t + 500) / 1000 ))
                        break
                    fi
                fi
            done

            gpus_model+=("$gpu_model")
            gpus_pct+=("$gpu_pct")
            gpus_vram_pct+=("$vram_pct")
            gpus_vram_str+=("$vram_str")
            gpus_temp+=("$gpu_temp")
        fi
    done

    # 4c. Intel
    for card in /sys/class/drm/card[0-9]; do
        [[ -d "$card/device" ]] || continue
        local drv; drv=$(grep -s '^DRIVER=' "$card/device/uevent" 2>/dev/null | cut -d= -f2)
        if [[ $drv == i915 || $drv == xe ]]; then
            local gpu_model="" gpu_pct="" gpu_temp="" vram_pct="" vram_str=""
            if command -v lspci &>/dev/null; then
                local slot; slot=$(basename "$(readlink -f "$card/device")")
                gpu_model=$(lc lspci -s "$slot" 2>/dev/null | sed -e 's/.*: //' -e 's/ (rev .*)//')
            fi
            [[ -z $gpu_model ]] && gpu_model="Intel Graphics"

            if [[ -f "$card/device/gpu_busy_percent" ]]; then
                gpu_pct=$(cat "$card/device/gpu_busy_percent" 2>/dev/null | tr -d '[:space:]')
            fi
            [[ $gpu_pct =~ ^[0-9]+$ ]] || gpu_pct=""

            for h in "$card/device"/hwmon/hwmon*; do
                [[ -d "$h" ]] || continue
                local hname; hname=$(cat "$h/name" 2>/dev/null)
                if [[ ( $hname == i915 || $hname == xe ) && -f "$h/temp1_input" ]]; then
                    local raw_t; raw_t=$(cat "$h/temp1_input" 2>/dev/null)
                    if [[ $raw_t =~ ^[0-9]+$ ]]; then
                        gpu_temp=$(( (raw_t + 500) / 1000 ))
                        break
                    fi
                fi
            done

            gpus_model+=("$gpu_model")
            gpus_pct+=("$gpu_pct")
            gpus_vram_pct+=("$vram_pct")
            gpus_vram_str+=("$vram_str")
            gpus_temp+=("$gpu_temp")
        fi
    done

    local count=${#gpus_model[@]}
    if (( count == 1 )); then
        print_gpu "GPU" "${gpus_model[0]}" "${gpus_pct[0]}" "${gpus_vram_pct[0]}" "${gpus_vram_str[0]}" "${gpus_temp[0]}"
    elif (( count > 1 )); then
        local i
        for (( i=0; i<count; i++ )); do
            print_gpu "GPU $i" "${gpus_model[i]}" "${gpus_pct[i]}" "${gpus_vram_pct[i]}" "${gpus_vram_str[i]}" "${gpus_temp[i]}"
        done
    fi

    if [[ -n $nv_state ]] && has_nvidia_gpu; then
        if [[ $nv_state == fail ]]; then
            row "NVIDIA" "${Y}$(t "kart bulundu ama sürücüye ulaşılamıyor (nvidia-smi başarısız)" "card found but driver not reachable (nvidia-smi failed)")${N}"
        else
            row "NVIDIA" "${D}$(t "kart bulundu; nvidia-smi yok (sürücü kurulu olmayabilir)" "card found; nvidia-smi not installed (driver may be missing)")${N}"
        fi
    fi
}

cmd_sys() {
    title "$(t "Sistem" "System")"

    # Start CPU stat sampling as early as possible for accurate 0.2s delta
    local u1 n1 s1 i1 w1 ir1 sr1 st1
    local u2 n2 s2 i2 w2 ir2 sr2 st2
    local has_stat=0
    if [[ -f /proc/stat ]]; then
        read -r _ u1 n1 s1 i1 w1 ir1 sr1 st1 _ < <(grep '^cpu ' /proc/stat)
        has_stat=1
    fi

    local cpu_model; cpu_model=$(sys_cpu_model)
    local cpu_temp; cpu_temp=$(sys_cpu_temp)

    local cpu_pct=""
    if (( has_stat )); then
        sleep 0.2
        read -r _ u2 n2 s2 i2 w2 ir2 sr2 st2 _ < <(grep '^cpu ' /proc/stat)
        local t1=$(( u1 + n1 + s1 + i1 + w1 + ir1 + sr1 + st1 ))
        local t2=$(( u2 + n2 + s2 + i2 + w2 + ir2 + sr2 + st2 ))
        local id1=$(( i1 + w1 ))
        local id2=$(( i2 + w2 ))
        local dt=$(( t2 - t1 ))
        local did=$(( id2 - id1 ))
        if (( dt > 0 )); then
            cpu_pct=$(( (dt - did) * 100 / dt ))
            (( cpu_pct < 0 )) && cpu_pct=0
            (( cpu_pct > 100 )) && cpu_pct=100
        fi
    fi

    # Fallback to /proc/loadavg
    if [[ -z $cpu_pct && -f /proc/loadavg ]]; then
        local cores
        cores=$(nproc 2>/dev/null || grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 1)
        (( cores < 1 )) && cores=1
        local load1
        load1=$(awk '{print $1}' /proc/loadavg 2>/dev/null)
        if [[ -n $load1 ]]; then
            cpu_pct=$(awk -v l="$load1" -v c="$cores" 'BEGIN{p=int((l/c)*100); if(p>100) p=100; if(p<0) p=0; print p}')
        fi
    fi

    row "CPU" "$cpu_model"
    [[ -n $cpu_pct ]] && row "$(t "CPU Kullanım" "CPU Usage")" "$(bar_usage "$cpu_pct")"
    [[ -n $cpu_temp ]] && row "$(t "CPU Sıcaklık" "CPU Temp")" "$(grade_temp "$cpu_temp")"

    sys_mem
    sys_gpu
}

